   <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="Profiles" Content="All profiles" Padding="10,6" FontSize="12" ToolTip="Browse task profiles and included apps. Your selection changes only when you choose Use profile."/><Button x:Name="UserProfiles" Content="User profiles ▾" Padding="10,6" FontSize="12" ToolTip="Save your selection as a profile or load a saved profile"/><Button x:Name="ClearSelection" Content="Clear selection" Padding="10,6" FontSize="12" Margin="0"/></WrapPanel>
   <ScrollViewer x:Name="LibraryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel x:Name="Welcome" Margin="4,6,4,18" Visibility="Collapsed"><TextBlock Text="Make this PC yours" FontFamily="{DynamicResource HeadingFont}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Start with everyday essentials or choose a profile for what you do. Every operation is yours to review." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel x:Name="WelcomeProfiles"/></StackPanel><WrapPanel x:Name="Cards" Width="{Binding ViewportWidth, ElementName=LibraryScroll}" HorizontalAlignment="Left"/><TextBlock x:Name="Empty" Text="No apps found. Try another search or filter." Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,25" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
   <Expander Grid.Row="3" Style="{StaticResource CategoryGroup}" Header="Activity &amp; details" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="Environment" Text="Checking WinGet…" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8"/><TextBox x:Name="LogBox" IsReadOnly="True" Height="135" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
  </Grid>
  <Border x:Name="SetupGlass" Grid.Column="2" Style="{StaticResource GlassPanel}" Margin="0,12,12,12">
   <Grid>
    <Border x:Name="SetupBackdrop" CornerRadius="25" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="24" RenderingBias="Performance"/></Border.Effect></Border>
    <Border CornerRadius="25" Background="{DynamicResource GlassPanelFill}" IsHitTestVisible="False"/>
    <Border x:Name="SetupReflection" CornerRadius="25" BorderBrush="#38E0CEFF" BorderThickness="1,1,0,0" Margin="1" IsHitTestVisible="False" Opacity="{DynamicResource GlassHighlightsOpacity}"><Border.Background><RadialGradientBrush Center="0.2,0.06" GradientOrigin="0.2,0.06" RadiusX="1.2" RadiusY="0.5"><GradientStop Color="#28E3D7FF" Offset="0"/><GradientStop Color="#0CB19AE4" Offset="0.4"/><GradientStop Color="#00B19AE4" Offset="1"/></RadialGradientBrush></Border.Background></Border>
   <Grid Margin="18,20,18,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="SetupHeading" FontFamily="{DynamicResource HeadingFont}" Text="Your setup" FontSize="20" FontWeight="SemiBold" Margin="0,0,90,0"/><TextBlock x:Name="SelectedCount" Text="0 apps selected" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,18"/><Button x:Name="SaveSetup" Content="Save selection..." ToolTip="Save these apps as a profile to load later" Margin="0" Padding="12,8"/><Border Height="1" Background="#46516B" Margin="0,16,0,12"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="QueuePanel"/></ScrollViewer>
    <StackPanel Grid.Row="2"><Border Height="1" Background="#46516B" Margin="0,14"/><TextBlock x:Name="Status" Text="Ready when you are." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/><TextBlock Text="Queue progress · apps processed" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/><ProgressBar x:Name="Progress" AutomationProperties.Name="App queue progress" Height="5" Background="#46516B" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Minimum="0" Maximum="100" Margin="0,0,0,14"/><TextBlock Text="Automatic: installs with WinGet.&#10;Guided: opens the official download page." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/><Button x:Name="Install" Content="Review &amp; install  →" Background="{DynamicResource AccentActionBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0"/><Button x:Name="Cancel" Content="Stop after current app" Margin="0,8,0,0" Visibility="Collapsed"/><Button x:Name="OpenLogs" Content="Open logs" Background="Transparent" BorderThickness="0" Padding="8" Margin="0,6,0,0"/></StackPanel>
   </Grid>
   </Grid>
  </Border>
  <Grid x:Name="UninstallPage" Grid.Column="1" Grid.ColumnSpan="2" Margin="18,12,14,18" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="InstalledAll" Content="All apps" Tag="All" Padding="12,6" FontSize="12"/><Button x:Name="InstalledDesktop" Content="Desktop" Tag="Desktop" Padding="12,6" FontSize="12"/><Button x:Name="InstalledStore" Content="Microsoft Store" Tag="Microsoft Store" Padding="12,6" FontSize="12"/></StackPanel>
   <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border CornerRadius="20" Background="{DynamicResource GlassControlFill}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" Margin="0,0,12,0"><Grid><TextBox x:Name="InstalledSearch" Background="Transparent" BorderThickness="0" Padding="15,10" AutomationProperties.Name="Search installed apps"/><TextBlock x:Name="InstalledSearchPlaceholder" Text="Search installed apps or publishers · Ctrl+F" Foreground="{DynamicResource TextSecondaryBrush}" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=InstalledSearch}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=InstalledSearch}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RefreshInstalled" Content="Refresh" Padding="12,8"/><Button x:Name="WindowsAppsSettings" Content="Windows settings ↗" Padding="12,8" Margin="0" ToolTip="Manage apps with missing or unsupported uninstallers in Windows Settings"/></StackPanel>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,16,0">
     <Grid><ListBox x:Name="InstalledList" Style="{StaticResource AppList}"><ListBox.ItemTemplate><DataTemplate><Border CornerRadius="16" Background="{DynamicResource ContentFill}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" Padding="15" Margin="0,0,4,8"><CheckBox Style="{StaticResource InstalledCheck}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRemove}" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Name}"><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="Use Windows Settings for this app" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanRemove}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></CheckBox></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock x:Name="InstalledEmpty" Text="Choose Refresh to find your installed apps." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="18,25" IsHitTestVisible="False"/>
     </Grid>
    </Grid>
    <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="20"><DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="Your removal" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="UninstallSelectedCount" Text="0 apps selected" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,18"/><Button x:Name="ClearUninstallSelection" Content="Clear selection" Padding="10,7" Margin="0"/><Border Height="1" Background="#46516B" Margin="0,18"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="A separate step" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Check for product folders and registry settings after removal. Nothing is selected or deleted automatically." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,14"/><Button x:Name="CheckLeftovers" Content="Check leftovers" Margin="0" IsEnabled="False"/><Button x:Name="OpenUninstallBackups" Content="Open backups" Background="Transparent" BorderThickness="0" Margin="0,8,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="The app’s own uninstaller will handle removal. It may ask for confirmation or administrator access." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/><Button x:Name="ReviewUninstall" Content="Review &amp; remove →" Background="{DynamicResource AccentActionBrush}" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold" Margin="0" IsEnabled="False"/><Button x:Name="StopUninstall" Content="Stop after current app" Margin="0,10,0,0" Visibility="Collapsed"/></StackPanel>
    </DockPanel></Border>
   </Grid>
   <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="UninstallStatus" Text="Installed apps have not been scanned yet." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Expander Style="{StaticResource CategoryGroup}" Header="Removal activity" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"><TextBox x:Name="UninstallLog" IsReadOnly="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander></StackPanel>
  </Grid>
 </Grid>

   <StackPanel x:Name="WindowControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Margin="0,30,30,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="MinimizeWindow" Style="{StaticResource CaptionButton}" Width="28" Height="28" MinHeight="28" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
    <Button x:Name="MaximizeWindow" Style="{StaticResource CaptionButton}" Width="28" Height="28" MinHeight="28" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Path x:Name="MaximizeGlyph" Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
    <Button x:Name="CloseWindow" Style="{StaticResource CaptionButton}" Width="28" Height="28" MinHeight="28" ToolTip="Close" AutomationProperties.Name="Close"><Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
   </StackPanel>
 </Grid>
</Window>
