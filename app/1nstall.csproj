<!-- 1nstall 4.0 as one .NET Framework executable: the compiled 3.6 interface, the C# host and the Rust engine as a resource. -->
<!-- Built by app\build.ps1, which passes Out (output folder) and EngineDll (the built oneinstall_engine.dll). -->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><AssemblyName>1nstall</AssemblyName><RootNamespace>OneInstall</RootNamespace><StartupObject>Program</StartupObject>
  <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
  <OutputPath>$(Out)\</OutputPath><IntermediateOutputPath>$(Out)\obj\</IntermediateOutputPath>
  <Optimize>true</Optimize><DebugType>none</DebugType><TreatWarningsAsErrors>true</TreatWarningsAsErrors><CodePage>65001</CodePage>
  <ApplicationManifest>..\src\app.manifest</ApplicationManifest><ApplicationIcon>..\src\1nstall.ico</ApplicationIcon>
 </PropertyGroup>
 <ItemGroup>
  <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Web.Extensions"/><Reference Include="System.Xaml"/>
  <Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/>
 </ItemGroup>
 <ItemGroup>
  <Page Include="$(Out)\src\interface.xaml"><Link>interface.xaml</Link></Page>
  <Compile Include="..\src\motion.cs"/><Compile Include="..\src\appearance.cs"/>
  <Compile Include="..\src\window-helper.cs"/><Compile Include="..\src\update-helper.cs"/>
  <Compile Include="Program.cs"/><Compile Include="Engine.cs"/><Compile Include="Shell.cs"/><Compile Include="Cards.cs"/><Compile Include="I18n.cs"/><Compile Include="Theme.cs"/><Compile Include="SettingsPage.cs"/>
  <EmbeddedResource Include="$(EngineDll)"><LogicalName>1nstall.Engine</LogicalName></EmbeddedResource>
 </ItemGroup>
 <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets"/>
</Project>
