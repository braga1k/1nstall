{
  "productName": "oneinstall-tauri",
  "version": "4.0.0",
  "identifier": "dev.oneinstall.prototype",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "1nstall 4.0 · Tauri",
        "width": 1240,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "backgroundColor": "#22252b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
